{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.8.0" }
  },
  "routes": [
    { "src": "/(partials|contenu)(/.*)?", "status": 404 },
    { "src": "/(README\\.md|vercel\\.json|\\.htaccess|\\.gitignore|\\.vercelignore)", "status": 404 },
    { "src": "/", "dest": "/api/index.php?__page=index" },
    { "src": "/(index|portfolio|projet|mentions-legales|carte-cadeau|admin)\\.php", "dest": "/api/index.php?__page=$1" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/assets/img/(.*)", "headers": { "cache-control": "public, max-age=2592000" }, "continue": true },
    { "src": "/assets/(css|js)/(.*)", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404, "dest": "/api/index.php?__page=404" }
  ]
}
